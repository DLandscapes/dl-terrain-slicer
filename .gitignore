# virtual environment (restore: python -m venv .venv && pip install -r requirements.txt)
.venv/

# Marc's manual milestone backups - kept on disk, never in git
back ups/

# session summaries and reference input (large / not source)
history/
input/

# large test data (test.tif, test.obj, shapefiles) - not needed at runtime;
# synthetic test fixtures are generated by tests/make_test_dtm.py
data/
tests/data/

# python
__pycache__/
*.pyc
.pytest_cache/

# local exports / scratch
demo_export*.zip

# browser build: the vendored Pyodide runtime (tens of MB, re-fetch with
# web/fetch_pyodide.py) and the generated static bundle
web/vendor/
web/dist/
